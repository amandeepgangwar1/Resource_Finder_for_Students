# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/resource-finder

# Use a long random value in production
JWT_SECRET=replace_with_a_long_random_secret

# Optional: Hugging Face token for hosted AI inference features
HF_API_KEY=

# Backend server port
PORT=5000

# Runtime environment
NODE_ENV=development

# Optional backend CORS allowlist. Use your Vercel URL in production.
# Multiple origins can be comma-separated.
CORS_ORIGIN=

# Render-only: pin Node to an LTS version
NODE_VERSION=22

# Vercel-only: your Render backend origin, for example:
# FRONTEND_API_ORIGIN=https://student-resource-finder-api.onrender.com
FRONTEND_API_ORIGIN=

# Optional SMTP configuration for live verification & password reset emails
# When left unconfigured, verification links and OTPs are safely provided in API responses for development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Student Resource Finder" <noreply@studentresourcefinder.com>

# Public frontend base URL (used in email links)
APP_BASE_URL=http://localhost:5000
